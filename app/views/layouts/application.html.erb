<!DOCTYPE html>
<html lang="en">
    <head>
        <% page_title = content_for?(:title) ? "#{content_for(:title)} — Aaron Grando" : "Aaron Grando — AI Product, Platform & Innovation Leader" %>
        <% page_description = "Aaron Grando is a product, enterprise AI, and creative technology leader in Philadelphia. Most recently VP, Creative Innovation; now building Gjelly and looking for his next full-time role." %>
        <meta charset="utf-8">
        <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
        <meta name="viewport" content="width=device-width">
        <meta name="description" content="<%= page_description %>">
        <link rel="canonical" href="<%= "https://gran.do#{request.path}" %>">
        <meta property="og:title" content="<%= page_title %>">
        <meta property="og:description" content="<%= page_description %>">
        <meta property="og:type" content="website">
        <meta property="og:url" content="<%= "https://gran.do#{request.path}" %>">
        <meta property="og:image" content="<%= image_url 'aaron-grando-og.png' %>">
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="<%= page_title %>">
        <meta name="twitter:description" content="<%= page_description %>">
        <meta name="twitter:image" content="<%= image_url 'aaron-grando-og.png' %>">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="preload" href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@300;400;500;600&display=swap" as="style">
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@300;400;500;600&display=swap">
        <link rel="preload" href="/preflight.css">
        <link rel="stylesheet" href="/preflight.css">
        <link rel="icon" type="image/x-icon" href="<%= image_url 'shield.svg' %>">

        <style type="text/css">
            body {
                background: #0F0D16;
                color: #CACACA;
                font-family: 'Libre Franklin', sans-serif;
                font-size: 18px;
                font-weight: 300;
            }

            a {
                cursor:pointer;
            }

            h1 {
                font-size: 1.6em;
                font-weight: 600;
                letter-spacing: -0.015em;
                margin-bottom: 0.4em;
            }

            h2 {
                font-weight: 500;
                font-size: 0.78em;
                letter-spacing: 0.16em;
                text-transform: uppercase;
                color: #828282;
            }

            h3 {
                font-size: 1.2em;
                font-weight: 600;
            }

            h1, h3 {
                padding-top: 1.5em;
                margin: 2em 0 0.333em 0 ;
            }

            p {
                margin: 1em 0;
                line-height: 1.7;
            }

            p a {
                color: #ed5aa0;
                text-decoration: none;
                font-weight: 500;
            }

            p a:hover {
                text-decoration: underline;
            }

            #container {
                max-width: 800px;
                margin: 100px 7.77%;
            }

            section#bio {
                max-width: 700px;
            }

            section#work { --accent: #ed5aa0; }
            section#gjelly { --accent: #27AE60; }
            section#clients { --accent: #F2C94C; }
            section#vibrations { --accent: #6A8CB5; }
            section#contact { --accent: #b59fc7; }
            section#translate { --accent: #F2994A; }

            section[id] h3 {
                border-top: none;
                padding-top: 0;
                margin-top: 3.5em;
            }

            section[id] h3::before {
                content: "";
                display: block;
                width: 140px;
                border-top: 1px solid var(--accent, #27AE60);
                margin-bottom: 1.75em;
            }

            section.entries p {
                strong {
                    font-weight: 600;
                    padding-right: 0.2em;
                }                
            }

            section.entries p strong a {
                color: inherit;
                text-decoration: none;
            }

            section.entries p strong a::after {
                content: " \2192";
                color: #ed5aa0;
                font-weight: 500;
            }

            section.entries p strong a:hover {
                color: #ed5aa0;
            }

            section.entries p .fun-fact {
                font-size: 0.9em;
                color: #6A8CB5;
            }

            section.entries p .fun-fact a {
                color: #6A8CB5;
                text-decoration: underline;
                text-underline-offset: 0.2em;
                font-weight: 400;
            }

            section.entries p .fun-fact a:hover {
                color: #ed5aa0;
            }

            section.entries p.platform-feature {
                margin: 1.75em 0 2.5em;
                padding: 1.35em 1.45em 1.3em;
                border-left: 2px solid #ed5aa0;
                background: rgba(237, 90, 160, 0.06);
            }

            section.entries p.platform-feature > .feature-label {
                display: block;
                margin-bottom: 0.8em;
                color: #b59fc7;
                font-size: 0.72em;
                font-weight: 500;
                letter-spacing: 0.16em;
            }

            section.entries p.platform-feature > strong {
                display: block;
                margin-bottom: 0.55em;
                font-size: 1.08em;
            }

            section.entries p.platform-feature .fun-fact {
                color: #b59fc7;
            }

            section.entries p.platform-feature .feature-links {
                display: inline-block;
                margin-top: 0.25em;
                font-size: 0.88em;
            }

            section.entries p.platform-feature .feature-links a {
                color: #ed5aa0;
                text-decoration: none;
                font-weight: 500;
            }

            section.entries p.platform-feature .feature-links a:hover {
                text-decoration: underline;
            }

            .with-visual {
                display: flex;
                align-items: flex-start;
                gap: 1.75em;
                margin: 1em 0;
            }

            .with-visual p {
                flex: 1 1 auto;
                margin: 0;
            }

            .with-visual .visual-slot {
                flex: 0 0 128px;
                width: 128px;
                height: 128px;
                border-radius: 4px;
                overflow: hidden;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #16171b;
            }

            .with-visual .visual-slot:empty {
                border: 1px dashed #3a3d44;
                color: #5a5e66;
                font-size: 0.72em;
                letter-spacing: 0.04em;
                line-height: 1.4;
                padding: 0.5em;
                text-align: center;
            }

            .with-visual .visual-slot img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }



            section.entries p.section-intro {
                max-width: 700px;
                color: #999999;
                font-size: 0.95em;
                margin-bottom: 2em;
            }



            section.entries p.bucket {
                font-size: 0.78em;
                font-weight: 500;
                letter-spacing: 0.16em;
                text-transform: uppercase;
                color: #828282;
                margin: 3em 0 1.4em 0;
            }

            section.entries p.bucket:first-of-type {
                margin-top: 2em;
            }

            section.entries p.client-list {
                max-width: 700px;
                color: #8d8d99;
                line-height: 2;
            }

            section#bio p#availability {
                margin-top: 2em;
                font-size: 0.95em;
                color: #999999;
            }

            section#bio p#availability .looking {
                display: block;
                color: #CACACA;
                margin-bottom: 0.6em;
            }

            section#bio p#availability strong {
                color: #CACACA;
                font-weight: 500;
            }

            section#bio p#availability .building-now {
                display: block;
                margin-top: 0.9em;
            }

            section#translate p {
                max-width: 700px;
            }

            section#vibrations li {
                justify-content: flex-start;
            }

            section#vibrations li strong {
                font-weight: 600;
            }

            section#vibrations .description {
                display: inline;
                margin-left: .777em;
                font-size: .9em;
                color: #828282;
            }

            section#contact p a {
                color: #ed5aa0;
                text-decoration: none;
                font-weight: 500;
            }

            ul {
                line-height: 1.78;
            }

            li {
                display: flex;
                flex-wrap: wrap;
                justify-content: space-between;
                color: #999999;
                padding: .2em 1.5em;
                margin-top: -.1em;
                margin-left: -1.5em;
                border-radius: 1em;
                transition: background-color linear 200ms; 
            }

            li strong {
                font-weight: 500;
            }

            section#work, section#gjelly, section#clients, section#vibrations, section#contact {
                margin-top: 5em;
            }

            section#vibrations a {
                color: #ed5aa0;
                text-decoration: none;
                font-weight: 500;
                margin-right: 0.777em;
            }

            section#vibrations a:hover {
                text-decoration: underline;
            }
            
            section#vibrations a span {
                color: #828282;
                font-size: 0.9em;
            }

            section#vibrations span.year {
                display: inline;
                margin-left: .777em;
                color: #c3c3c3;
            }

            @media only screen and (max-width: 900px) {
                .with-visual {
                    flex-direction: column;
                }

                .with-visual .visual-slot {
                    width: 100%;
                    max-width: 280px;
                    flex-basis: auto;
                    height: 280px;
                }


                #container {
                    margin-top: 50px;
                    margin-bottom: 50px;
                    margin-right: 7.77%;
                }

                li {
                    margin-top: 1.5em;
                    margin-bottom: 1.5em;
                }

                section#vibrations .description, section#vibrations span.year {
                    display: inline-block;
                    margin-left: 0;
                    line-height: 1.5;
                }                
                
                section#vibrations .description {
                    font-size: 0.9em;
                    width: 100%;
                }            
                
                section#vibrations span.year {
                    display: inline-block;
                    width: 100%;
                    margin-left: 0;
                    line-height: 1.5;
                }
            }

            /* Case-study and resume subpages */
            .case { max-width: 768px; --accent: #ed5aa0; }
            .case .crumb { margin-top: 2em; font-size: 0.95em; }
            .case .crumb a { color: #ed5aa0; text-decoration: none; font-weight: 500; }
            .case .crumb a:hover { text-decoration: underline; }
            .case h1 { font-size: 1.6em; padding-top: 0; margin-top: 0.75em; }
            .case h2 {
                font-weight: 400;
                font-size: 1.05em;
                letter-spacing: normal;
                text-transform: none;
                color: #999999;
                line-height: 1.6;
                margin: 0.5em 0 1em 0;
            }
            .case section#cs-top h3, .case section#rs-top h3 { display: none; }
            .case p strong { font-weight: 600; }
            .case .metrics { color: #8d8d99; }
            .case .metrics strong { color: #CACACA; font-weight: 500; }
            .case .lede {
                max-width: 700px;
                color: #b6b4bd;
                font-size: 1.05em;
                line-height: 1.7;
            }
            .case .case-nav {
                display: flex;
                flex-wrap: wrap;
                gap: 0.75em 1.5em;
                margin: 2.4em 0 3.5em;
                padding: 1em 0;
                border-top: 1px solid #34303d;
                border-bottom: 1px solid #34303d;
            }
            .case .case-nav a {
                color: #c4c1ca;
                text-decoration: none;
                font-size: 0.9em;
                font-weight: 500;
            }
            .case .case-nav a span {
                margin-right: 0.45em;
                color: #b59fc7;
                font-size: 0.8em;
                letter-spacing: 0.08em;
            }
            .case .case-nav a:hover { color: #ed5aa0; }

            .case .report-figure { margin: 1.75em 0; }
            .case .report-figure img {
                width: 100%;
                height: auto;
                display: block;
                border-radius: 10px;
                border: 1px solid #34303d;
            }
            .case .report-figure figcaption {
                margin-top: 0.65em;
                font-size: 0.85em;
                color: #8d8d99;
                line-height: 1.5;
            }

            @media only screen and (max-width: 900px) {
                .case h1 { font-size: 1.35em; }
            }

            @keyframes pulse-purple {
                0% {
                    color: #b59fc7;
                }
                25% {
                    color: #a692b8;
                }
                50% {
                    color: #9885aa;
                }
                75% {
                    color: #ad9cbb;
                }
                100% {
                    color: #b59fc7;
                }
            }

            .highlight {
                animation: pulse-purple 6s ease-in-out infinite;
            }

        </style>

        <title>
            <%= page_title %>
        </title>
    </head>
    <body id="<%= params[:controller] %>" class="<%= params[:action] %>">
        <%= yield %>
    </body>
    <%= render partial: 'shared/stache'%>
</html>
