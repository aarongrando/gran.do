<!DOCTYPE html>
<html lang="en">
    <head>
        <% page_title = content_for?(:title) ? "#{content_for(:title)} — Aaron Grando" : "Aaron Grando — AI Product, Platform & Innovation Leader" %>
        <% page_description = content_for?(:description) ? content_for(:description) : "Aaron Grando is a product, enterprise AI, and creative technology leader in Philadelphia. Most recently VP, Creative Innovation, and looking for his next full-time role." %>
        <meta charset="utf-8">
        <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
        <meta name="viewport" content="width=device-width">
        <meta name="description" content="<%= page_description %>">
        <% if action_name == "index" %>
        <meta name="msvalidate.01" content="FDC44C179F35930AFEA192612EA01D33">
        <% end %>
        <link rel="canonical" href="<%= canonical_page_url %>">
        <link rel="describedby" href="https://gran.do/llms.txt" type="text/plain">
        <script type="application/ld+json"><%= raw json_escape(page_structured_data(title: page_title, description: page_description).to_json) %></script>
        <meta property="og:title" content="<%= page_title %>">
        <meta property="og:description" content="<%= page_description %>">
        <meta property="og:type" content="website">
        <meta property="og:url" content="<%= canonical_page_url %>">
        <meta property="og:image" content="<%= image_url 'aaron-grando-og.png' %>">
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="<%= page_title %>">
        <meta name="twitter:description" content="<%= page_description %>">
        <meta name="twitter:image" content="<%= image_url 'aaron-grando-og.png' %>">
        <link rel="preload" href="<%= font_path 'libre-franklin-latin-variable.woff2' %>" as="font" type="font/woff2" crossorigin>
        <link rel="icon" type="image/x-icon" href="<%= image_url 'shield.svg' %>">

        <%= render "shared/critical_styles" %>

        <title>
            <%= page_title %>
        </title>
    </head>
    <body id="<%= params[:controller] %>" class="<%= params[:action] %><%= ' case-page' if %w[nexus geo launchpad mod_heat].include?(params[:action]) %>">
        <%= yield %>
        <%= render "shared/analytics" %>
    </body>
    <%= render partial: 'shared/stache'%>
</html>
